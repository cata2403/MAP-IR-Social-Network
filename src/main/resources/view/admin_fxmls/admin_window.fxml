<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ubb.presentation_layer.controllers.admin_gui.AdminController">
    <children>
        <TableView fx:id="duckTableView" layoutX="14.0" layoutY="204.0" prefHeight="166.0" prefWidth="334.0">
            <columns>
                <TableColumn fx:id="tableColUsernameDuck" prefWidth="75.0" text="username" />
                <TableColumn fx:id="tableColType" prefWidth="75.0" text="duck type" />
                <TableColumn fx:id="tableColSpeed" prefWidth="75.0" text="speed" />
                <TableColumn fx:id="tableColResistance" prefWidth="75.0" text="resistance" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <TableView fx:id="personTableView" layoutX="14.0" layoutY="14.0" prefHeight="158.0" prefWidth="334.0">
            <columns>
                <TableColumn fx:id="tableColUsernamePer" prefWidth="65.5999755859375" text="username" />
                <TableColumn fx:id="tableColFirstName" prefWidth="61.60003662109375" text="first name" />
                <TableColumn fx:id="tableColLastName" prefWidth="60.800048828125" text="last name" />
                <TableColumn fx:id="tableColOccupation" prefWidth="71.99993896484375" text="occupation" />
                <TableColumn fx:id="tableColBirthDate" prefWidth="72.0" text="birth date" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <ComboBox fx:id="dTypeCb" layoutX="14.0" layoutY="181.0" prefWidth="150.0" promptText="duck type">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="FLYING" />
                    <String fx:value="SWIMMING" />
                    <String fx:value="FLYING_AND_SWIMMING" />
                    <String fx:value="ALL" />
                </FXCollections>
            </items>
        </ComboBox>
        <Button layoutX="357.0" layoutY="261.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="108.0" text="delete" onAction="#handlerDeleteButton"/>
        <Button layoutX="478.0" layoutY="261.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="108.0" text="add friendship" onAction="#handlerAddFriendButton" />
        <Button layoutX="357.0" layoutY="226.0" mnemonicParsing="false" onAction="#handlerAddDuckButton" prefHeight="26.0" prefWidth="108.0" text="add duck" />
        <Button layoutX="478.0" layoutY="226.0" mnemonicParsing="false" onAction="#handlerAddPersonButton" prefHeight="26.0" prefWidth="108.0" text="add person" />
        <Button layoutX="358.0" layoutY="295.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="108.0" text="find nr of groups" onAction="#handlerNrGrButton"/>
        <Button layoutX="479.0" layoutY="296.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="108.0" text="find largest group" onAction="#handlerLargestGrButton" />
        <Button layoutX="14.0" layoutY="370.0" mnemonicParsing="false" onAction="#handlerPrevButton" prefHeight="26.0" prefWidth="34.0" text="&lt;" />
        <Button layoutX="48.0" layoutY="370.0" mnemonicParsing="false" onAction="#handlerNextButton" prefHeight="26.0" prefWidth="34.0" text="&gt;" />
        <TableView fx:id="frshipTableView" layoutX="388.0" layoutY="14.0" prefHeight="194.0" prefWidth="179.0">
            <columns>
                <TableColumn fx:id="tableColId1" prefWidth="44.800048828125" text="User 1" />
                <TableColumn fx:id="tableColId2" prefWidth="46.39996337890625" text="User 2" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</AnchorPane>
