<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="304.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ubb.presentation_layer.controllers.user_gui.FriendRequestsController">
    <children>
        <TableView fx:id="tableView" layoutX="25.0" layoutY="45.0" prefHeight="297.0" prefWidth="250.0">
            <columns>
                <TableColumn fx:id="usernameCol" prefWidth="75.0" text="Username" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <Label layoutX="47.0" layoutY="14.0" text="Friendship requests from other users" />
        <Button layoutX="97.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleAcceptButton" text="Accept" />
        <Button layoutX="150.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleDeclineButton" text="Decline" />
    </children>
</AnchorPane>
